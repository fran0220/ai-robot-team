# Git
.git/
.gitignore

# Local state
.openclaw/
.env
.env.local
.env.*

# Apps (deployed separately)
apps/

# Node modules
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp
*.tmp
*.swp

# Agent workspace runtime data (but keep personality files)
teams/robotics/shared/designs/
teams/robotics/shared/cad/

# Exclude runtime-generated files, keep personality files
teams/robotics/agents/*/workspace/docs.bak/
platform/agents/*/workspace/

# Explicitly include agent personality files
!teams/robotics/agents/*/workspace/*.md
!teams/robotics/agents/*/workspace/memory/
!teams/robotics/agents/*/workspace/tasks/

# Large workspace files (top-level only)
/workspace/
