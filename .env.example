# OpenClaw Configuration
# Copy this file to .env and fill in your values

# ========================================
# Telegram Bot
# ========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========================================
# Mission Control V2 (PostgreSQL)
# ========================================
MISSION_CONTROL_URL=https://mission-control-v2-production-33ad.up.railway.app

# Legacy Convex (deprecated, use Mission Control V2)
# CONVEX_URL=https://convex-backend-production-3dbe.up.railway.app
# CONVEX_ADMIN_KEY=your_convex_admin_key_here

# ========================================
# Model Providers
# ========================================
# 代理服务器地址（用于 LLM 推理）
PROXY_BASE_URL=http://67.230.171.248:8317
PROXY_API_KEY=sk-123456

# OpenAI API Key（用于 Embedding 向量记忆搜索）
OPENAI_API_KEY=sk-your_openai_api_key_here

# 备选：Gemini API Key（如果不用 OpenAI embedding）
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Web Research & Scraping
# ========================================
# Firecrawl - 高级网页抓取 (firecrawl skill 需要)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Parallel Search - 深度网络搜索 (web-research skill 需要)
PARALLEL_API_KEY=your_parallel_api_key_here

# ========================================
# Image Generation (Optional)
# ========================================
# Nano Banana Pro API (id-design skill 可选，也可用 Gemini App)
# NANOBANANA_API_KEY=your_nanobanana_api_key_here

# ========================================
# Railway (Optional)
# ========================================
RAILWAY_PROJECT_ID=d896ccfb-1264-4e00-a308-e803ce412bca

# ========================================
# OpenClaw Paths
# ========================================
OPENCLAW_CONFIG_PATH=./openclaw.json
OPENCLAW_STATE_DIR=./.openclaw
