# ====================================
# Mission Control V2 Configuration
# ====================================

# PostgreSQL Database (Railway)
# Internal URL for Railway deployments
DATABASE_URL=postgresql://user:password@host:5432/database

# ====================================
# OpenClaw Gateway Configuration
# ====================================

# OpenClaw Gateway URL
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# OpenClaw Gateway authentication token
OPENCLAW_GATEWAY_TOKEN=

# ====================================
# Workspace Configuration
# ====================================

# Mission Control API URL (auto-detected if not set)
# MISSION_CONTROL_URL=http://localhost:3000

# Base workspace directory
WORKSPACE_BASE_PATH=/workspace

# Projects directory
PROJECTS_PATH=/workspace/projects

# ====================================
# Node Environment
# ====================================
NODE_ENV=development

# ====================================
# MinIO Configuration
# ====================================

# MinIO endpoint (without protocol)
MINIO_ENDPOINT=minio-production-e654.up.railway.app

# MinIO credentials
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=

# MinIO bucket name
MINIO_BUCKET=team-assets

# Use SSL for MinIO connection
MINIO_USE_SSL=true

# ====================================
# kkFileView 预览服务
# ====================================

# kkFileView 服务 URL (Railway 内网)
KKFILEVIEW_URL=http://localhost:8012

# MinIO 公网 endpoint (用于 kkFileView 访问)
MINIO_PUBLIC_ENDPOINT=minio-production-e654.up.railway.app

# ====================================
# Security Notes
# ====================================
# 
# NEVER commit .env.local with real database credentials!
# Use Railway's environment variables for production.
